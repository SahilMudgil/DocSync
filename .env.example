# Google Gemini API key (for cloud hosted LLM judge)
GOOGLE_API_KEY=your_gemini_api_key_here

# Ollama local/EC2 instance URL (e.g. on AWS EC2 or localhost)
OLLAMA_BASE_URL=http://localhost:11434
DOCSYNC_LLM_MODEL=deepseek-coder:6.7b

# Sourcegraph setup (optional, tier 1/2)
SOURCEGRAPH_URL=http://localhost:7080
SOURCEGRAPH_TOKEN=your_token_here

# GitHub Actions token (set automatically in CI)
GITHUB_TOKEN=
